# ── Fayda Pro Server Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# JWT Secret (change this to a long random string in production)
JWT_SECRET=your-long-random-secret-here

# SuperAdmin initial password (used only when subscribers.json is first created)
# After first run, change it via the Admin panel — it will be stored as bcrypt hash
SUPERADMIN_INIT_PASSWORD=YourSecurePasswordHere

# Admin API Key (used for broker management endpoints)
ADMIN_SECRET_KEY=fayda-terminal-admin-2026

# ── Notification Channels (optional — can also be set via Admin UI) ──────────

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1415XXXXXXX

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token

# SMTP Email
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Fayda Pro Alerts
SMTP_FROM_EMAIL=alerts@yourdomain.com
